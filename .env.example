# Copy to .env.local and fill in. Every variable is read server-side only.
# None of them are prefixed NEXT_PUBLIC_, so none reach the browser bundle.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=
# Anon key. Used only if SUPABASE_SERVICE_ROLE_KEY is empty (see README: RLS).
SUPABASE_ANON_KEY=
# Recommended: service role key. Lets the server bypass RLS so the tables can stay
# locked to the public. Never expose this key; it is only read in server code.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio / Gemini API key
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash
GEMINI_MODEL=

# Resend API key and a sender on a domain verified in Resend
RESEND_API_KEY=
HIRING_FROM_EMAIL=
# Optional display name and signature for outgoing mail
HIRING_FROM_NAME=Arjun Mehta
HIRING_SIGNATURE=Arjun Mehta\nFounder, Kargo

# Optional safety net for testing: if set, every email goes to this address
# instead of the candidate's (e.g. the MESA test inbox).
EMAIL_REDIRECT_TO=
